# Anthropic — required for all LLM calls through Gateway
ANTHROPIC_API_KEY=

# AWS — required for Textract (primary OCR path)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Patient — UUID of the accepted patient (defaults to Mark's capstone UUID if unset)
VITALOG_PATIENT_ID=

# Supabase — required for persistence layer
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Postgres connection string for migrations (Settings → Database → Connection string)
SUPABASE_DB_URL=
